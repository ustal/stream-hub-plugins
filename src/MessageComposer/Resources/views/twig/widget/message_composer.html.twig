<form class="stream-hub-message-composer" method="post" action="{{ action_url }}">
    <input type="hidden" name="{{ stream_field_name }}" value="{{ stream_id }}">
    {% if csrf_token is not null %}
        <input type="hidden" name="{{ csrf_field_name }}" value="{{ csrf_token }}">
    {% endif %}

    <div class="stream-hub-message-composer__body">
        <textarea
            class="stream-hub-message-composer__input"
            name="{{ message_field_name }}"
            rows="3"
            placeholder="{{ placeholder }}"
        ></textarea>
    </div>

    <div class="stream-hub-message-composer__actions">
        <button class="stream-hub-message-composer__submit" type="submit">{{ submit_label }}</button>
    </div>
</form>
